<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="2.0dip" />
            <gradient android:startColor="#ff075aa0" android:endColor="#ff075aa0" android:angle="45.0" android:type="linear" android:centerX="48.0%" android:centerColor="#ff095ec9" />
            <stroke android:width="1.0dip" android:color="#ffd9d5da" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="2.0dip" />
            <gradient android:startColor="#ff075aa0" android:endColor="#ff075aa0" android:angle="45.0" android:type="linear" android:centerX="48.0%" android:centerColor="#ff61a0f0" />
            <stroke android:width="1.0dip" android:color="#ffefedf1" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="2.0dip" />
            <gradient android:startColor="#ff3d3f40" android:endColor="#ff3d3f40" android:angle="45.0" android:type="linear" android:centerX="48.0%" android:centerColor="#ff000000" />
            <stroke android:width="1.0dip" android:color="#ff5b575c" />
        </shape>
    </item>
</selector>